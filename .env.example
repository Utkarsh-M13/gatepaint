# Supabase config for the global "New" gallery. Copy this file to .env.local
# and fill in the values from your Supabase project (Project Settings > API).
# Both are safe to expose in the client: the URL is public and the anon key is
# the publishable key, gated by row-level security. Leave these blank and the
# app still builds and runs; the New tab just shows a "not set up" state.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
